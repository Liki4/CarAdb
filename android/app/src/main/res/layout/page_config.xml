<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_config"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_page_padding"
            android:paddingTop="@dimen/ui_section_gap"
            android:paddingEnd="@dimen/ui_page_padding"
            android:paddingBottom="@dimen/ui_gap">

            <TextView
                style="@style/Ui.Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_config_heading" />
            <TextView
                style="@style/Ui.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_small_gap"
                android:layout_marginBottom="@dimen/ui_section_gap"
                android:text="@string/ui_config_intro" />
            <TextView
                android:id="@+id/config_readonly"
                style="@style/Ui.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ui_gap"
                android:background="@drawable/ui_chip_background"
                android:drawableStart="@drawable/ui_lock"
                android:drawablePadding="@dimen/ui_gap"
                android:gravity="center_vertical"
                android:padding="@dimen/ui_gap"
                android:text="@string/ui_config_readonly"
                android:visibility="gone" />

            <TextView
                style="@style/Ui.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@+id/config"
                android:text="@string/config_label" />
            <EditText
                android:id="@+id/config"
                style="@style/Ui.Editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_small_gap"
                android:gravity="top|start"
                android:hint="@string/config_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minHeight="@dimen/ui_editor_min_height"
                android:minLines="6"
                android:maxLines="12"
                android:saveEnabled="false"
                android:scrollHorizontally="false"
                android:scrollbars="vertical" />
            <TextView
                style="@style/Ui.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_gap"
                android:background="@drawable/panel_background"
                android:padding="@dimen/ui_gap"
                android:text="@string/config_note" />

            <TextView
                style="@style/Ui.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_section_gap"
                android:labelFor="@+id/host"
                android:text="@string/host_label" />
            <EditText
                android:id="@+id/host"
                style="@style/Ui.Editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_small_gap"
                android:hint="@string/host_hint"
                android:importantForAutofill="no"
                android:inputType="textUri|textNoSuggestions"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:singleLine="true"
                android:saveEnabled="false"
                android:text="@string/host_hint"
                android:textSize="@dimen/ui_host_text" />
            <TextView
                android:id="@+id/config_error"
                style="@style/Ui.Text.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_gap"
                android:visibility="gone" />
            <TextView
                style="@style/Ui.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_gap"
                android:text="@string/ui_save_note" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_stroke"
        android:background="@color/ui_line"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:id="@+id/config_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_page_padding"
        android:paddingTop="@dimen/ui_page_vertical_padding"
        android:paddingEnd="@dimen/ui_page_padding"
        android:paddingBottom="@dimen/ui_page_vertical_padding">
        <TextView
            android:id="@+id/storage_status"
            style="@style/Ui.Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:text="@string/profile_loading" />
        <Button
            android:id="@+id/save"
            style="@style/Ui.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ui_gap"
            android:drawableStart="@drawable/ui_check"
            android:enabled="false"
            android:text="@string/save_profile" />
    </LinearLayout>
</LinearLayout>

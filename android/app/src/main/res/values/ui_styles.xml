<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Ui.Text" parent="android:style/Widget.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/ui_body_text</item>
        <item name="android:textColor">@color/ui_text_primary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:breakStrategy">simple</item>
    </style>
    <style name="Ui.Text.Secondary" parent="Ui.Text">
        <item name="android:textColor">@color/ui_text_secondary</item>
    </style>
    <style name="Ui.Text.Caption" parent="Ui.Text.Secondary">
        <item name="android:textSize">@dimen/ui_caption_text</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>
    <style name="Ui.Text.Title" parent="Ui.Text">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/ui_title_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.08</item>
    </style>
    <style name="Ui.Text.PageTitle" parent="Ui.Text">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/ui_page_title_text</item>
    </style>
    <style name="Ui.Text.SectionTitle" parent="Ui.Text">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/ui_section_title_text</item>
    </style>
    <style name="Ui.Text.Label" parent="Ui.Text">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/ui_label_text</item>
    </style>
    <style name="Ui.Text.Error" parent="Ui.Text">
        <item name="android:textColor">@color/ui_status_error</item>
        <item name="android:background">@drawable/ui_error_background</item>
        <item name="android:padding">@dimen/ui_gap</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>
    <style name="Ui.Button" parent="android:style/Widget.Material.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/ui_control_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/ui_control_height</item>
        <item name="android:paddingStart">@dimen/ui_control_padding</item>
        <item name="android:paddingEnd">@dimen/ui_control_padding</item>
        <item name="android:paddingTop">@dimen/ui_control_vertical_padding</item>
        <item name="android:paddingBottom">@dimen/ui_control_vertical_padding</item>
        <item name="android:gravity">center</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:drawablePadding">@dimen/ui_small_gap</item>
        <item name="android:breakStrategy">simple</item>
    </style>
    <style name="Ui.Button.Primary" parent="Ui.Button">
        <item name="android:background">@drawable/ui_primary_background</item>
        <item name="android:textColor">@color/ui_primary_foreground</item>
        <item name="android:drawableTint">@color/ui_primary_foreground</item>
    </style>
    <style name="Ui.Button.Secondary" parent="Ui.Button">
        <item name="android:background">@drawable/ui_secondary_background</item>
        <item name="android:textColor">@color/ui_secondary_foreground</item>
        <item name="android:drawableTint">@color/ui_secondary_foreground</item>
    </style>
    <style name="Ui.Button.Quiet" parent="Ui.Button">
        <item name="android:background">@drawable/ui_quiet_background</item>
        <item name="android:textColor">@color/ui_nav_foreground</item>
        <item name="android:drawableTint">@color/ui_nav_foreground</item>
        <item name="android:textSize">@dimen/ui_caption_text</item>
        <item name="android:paddingStart">@dimen/ui_small_gap</item>
        <item name="android:paddingEnd">@dimen/ui_small_gap</item>
    </style>
    <style name="Ui.Button.Power" parent="Ui.Button.Primary">
        <item name="android:background">@drawable/ui_power_background</item>
        <item name="android:minHeight">@dimen/ui_action_height</item>
        <item name="android:textSize">@dimen/ui_action_text</item>
        <item name="android:paddingStart">@dimen/ui_power_padding</item>
        <item name="android:paddingEnd">@dimen/ui_power_padding</item>
        <item name="android:paddingTop">@dimen/ui_power_padding</item>
        <item name="android:paddingBottom">@dimen/ui_power_padding</item>
        <item name="android:drawableTop">@drawable/ui_power</item>
        <item name="android:drawablePadding">@dimen/ui_gap</item>
    </style>
    <style name="Ui.Button.Power.Stop" parent="Ui.Button.Power">
        <item name="android:background">@drawable/ui_power_stop_background</item>
        <item name="android:textColor">@color/ui_secondary_foreground</item>
        <item name="android:drawableTint">@color/ui_secondary_foreground</item>
    </style>
    <style name="Ui.Button.Nav" parent="Ui.Button">
        <item name="android:background">@drawable/ui_nav_background</item>
        <item name="android:textColor">@color/ui_nav_foreground</item>
        <item name="android:drawableTint">@color/ui_nav_foreground</item>
        <item name="android:minHeight">@dimen/ui_nav_item_height</item>
        <item name="android:textSize">@dimen/ui_nav_text</item>
        <item name="android:drawablePadding">@dimen/ui_nav_icon_gap</item>
        <item name="android:paddingStart">@dimen/ui_small_gap</item>
        <item name="android:paddingEnd">@dimen/ui_small_gap</item>
        <item name="android:paddingTop">@dimen/ui_small_gap</item>
        <item name="android:paddingBottom">@dimen/ui_small_gap</item>
    </style>
    <style name="Ui.Editor" parent="android:style/Widget.Material.EditText">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">@dimen/ui_editor_text</item>
        <item name="android:textColor">@color/ui_input_foreground</item>
        <item name="android:textColorHint">@color/ui_text_hint</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">@dimen/ui_control_height</item>
        <item name="android:padding">@dimen/ui_field_padding</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:breakStrategy">simple</item>
    </style>
    <style name="Ui.Switch" parent="android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/ui_label_text</item>
        <item name="android:textColor">@color/ui_input_foreground</item>
        <item name="android:minHeight">@dimen/ui_control_height</item>
        <item name="android:paddingTop">@dimen/ui_small_gap</item>
        <item name="android:paddingBottom">@dimen/ui_small_gap</item>
        <item name="android:background">@drawable/ui_quiet_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:thumb">@drawable/ui_switch_thumb</item>
        <item name="android:track">@drawable/ui_switch_track</item>
        <item name="android:thumbTint">@null</item>
        <item name="android:trackTint">@null</item>
        <item name="android:switchMinWidth">@dimen/ui_switch_width</item>
        <item name="android:switchPadding">@dimen/ui_gap</item>
        <item name="android:showText">false</item>
        <item name="android:splitTrack">false</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <size android:width="@dimen/ui_switch_width" android:height="@dimen/ui_switch_track_height" />
            <corners android:radius="@dimen/ui_switch_track_height" />
            <solid android:color="@color/ui_switch_disabled" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="@dimen/ui_switch_width" android:height="@dimen/ui_switch_track_height" />
            <corners android:radius="@dimen/ui_switch_track_height" />
            <solid android:color="@color/ui_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="@dimen/ui_switch_width" android:height="@dimen/ui_switch_track_height" />
            <corners android:radius="@dimen/ui_switch_track_height" />
            <solid android:color="@color/ui_switch_off" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_page_padding"
        android:paddingTop="@dimen/ui_section_gap"
        android:paddingEnd="@dimen/ui_page_padding"
        android:paddingBottom="@dimen/ui_section_gap">

        <TextView
            style="@style/Ui.Text.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_settings_heading" />
        <TextView
            style="@style/Ui.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_small_gap"
            android:layout_marginBottom="@dimen/ui_section_gap"
            android:text="@string/ui_settings_intro" />
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_stroke"
            android:background="@color/ui_line"
            android:importantForAccessibility="no" />

        <Switch
            android:id="@+id/boot_auto_connect"
            style="@style/Ui.Switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap"
            android:checked="false"
            android:enabled="false"
            android:saveEnabled="false"
            android:text="@string/boot_auto_connect" />
        <TextView
            style="@style/Ui.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_small_gap"
            android:layout_marginBottom="@dimen/ui_section_gap"
            android:text="@string/boot_note" />
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_stroke"
            android:background="@color/ui_line"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/Ui.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_section_gap"
            android:text="@string/ui_background_heading" />
        <TextView
            style="@style/Ui.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_small_gap"
            android:text="@string/background_note" />
        <Button
            android:id="@+id/battery_settings"
            style="@style/Ui.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/ui_gap"
            android:drawableEnd="@drawable/ui_chevron"
            android:text="@string/battery_settings" />
        <TextView
            android:id="@+id/battery_status"
            style="@style/Ui.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_small_gap"
            android:layout_marginBottom="@dimen/ui_section_gap" />
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_stroke"
            android:background="@color/ui_line"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/Ui.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_section_gap"
            android:text="@string/ui_local_adb" />
        <TextView
            style="@style/Ui.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_small_gap"
            android:text="@string/ui_probe_note" />
        <Button
            android:id="@+id/probe"
            style="@style/Ui.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/ui_gap"
            android:enabled="false"
            android:text="@string/probe" />
        <TextView
            android:id="@+id/probe_result"
            style="@style/Ui.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_small_gap"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/ui_accent" />
        <TextView
            android:id="@+id/settings_error"
            style="@style/Ui.Text.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>

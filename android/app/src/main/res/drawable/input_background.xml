<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_quiet" />
            <corners android:radius="@dimen/ui_control_radius" />
            <stroke android:width="@dimen/ui_stroke" android:color="@color/ui_line" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_background" />
            <corners android:radius="@dimen/ui_control_radius" />
            <stroke android:width="@dimen/ui_focus_stroke" android:color="@color/ui_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_background" />
            <corners android:radius="@dimen/ui_control_radius" />
            <stroke android:width="@dimen/ui_stroke" android:color="@color/ui_line" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/ui_switch_thumb_inset"
    android:insetTop="@dimen/ui_switch_thumb_inset"
    android:insetRight="@dimen/ui_switch_thumb_inset"
    android:insetBottom="@dimen/ui_switch_thumb_inset">
    <selector>
        <item android:state_enabled="false">
            <shape android:shape="oval">
                <size android:width="@dimen/ui_switch_thumb_size" android:height="@dimen/ui_switch_thumb_size" />
                <solid android:color="@color/ui_switch_thumb_disabled" />
            </shape>
        </item>
        <item android:state_checked="true">
            <shape android:shape="oval">
                <size android:width="@dimen/ui_switch_thumb_size" android:height="@dimen/ui_switch_thumb_size" />
                <solid android:color="@color/ui_on_accent" />
            </shape>
        </item>
        <item>
            <shape android:shape="oval">
                <size android:width="@dimen/ui_switch_thumb_size" android:height="@dimen/ui_switch_thumb_size" />
                <solid android:color="@color/ui_switch_thumb_off" />
            </shape>
        </item>
    </selector>
</inset>
